; CINIS LAURI — Godot 4, Android landscape, 320 x 180 pixel viewport.
config_version=5

[application]
config/name="CINIS LAURI — Пепел лавра"
run/main_scene="res://scenes/StoryMain.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Original historical pixel-art game — branching Russian narrative."

[autoload]
StoryRuntime="*res://scripts/story_runtime.gd"
GameServices="*res://scripts/game_services.gd"

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.168627, 0.105882, 0.078431, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[input_devices]
pointing/emulate_mouse_from_touch=true
