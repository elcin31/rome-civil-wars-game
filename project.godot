; CINIS LAURI — Godot 4, Android landscape, 640 x 360 world, adaptive mobile UI.
config_version=5

[application]
config/name="CINIS LAURI — Пепел лавра"
config/icon="res://assets/final/app_icon.png"
run/main_scene="res://scenes/StoryMain.tscn"
run/max_fps=60
boot_splash/image="res://assets/final/splash.png"
boot_splash/bg_color=Color(0.078431, 0.082353, 0.121569, 1)
boot_splash/fullsize=true
boot_splash/use_filter=false
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Original Roman pixel-art RPG, turn-based tactics and platformer."

[autoload]
StoryRuntime="*res://scripts/story_runtime.gd"
GameServices="*res://scripts/game_services.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.168627, 0.105882, 0.078431, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[input_devices]
pointing/emulate_mouse_from_touch=true

[debug]
gdscript/warnings/exclude_addons=true
