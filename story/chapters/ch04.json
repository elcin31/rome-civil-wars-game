        "ru": "",
        "en": ""
      },
      "choices": [
        {
          "id": "ch04_s06_read",
          "text": {
            "ru": "Прочитать договор всем свидетелям",
            "en": ""
          },
          "set_flags": [
            "witnesses_shared"
