      "text": {
        "ru": "",
        "en": ""
      },
      "choices": [
        {
          "id": "ch06_s03_owners",
          "text": {
            "ru": "Проверить прежних владельцев",
            "en": ""
          },
          "set_flags": [
            "home_claim"
          ],
          "clear_flags": [],
          "rep": {
            "citizens": 2
          },
          "bond": 4,
