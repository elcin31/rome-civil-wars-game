  "nodes": [
    {
      "id": "ch06_s01_n01",
      "scene": "ch06_s01",
      "kind": "cutscene",
      "speaker": "history",
      "portrait": "brutus_neutral",
      "text": {
        "ru": "Перед Филиппами римские знамёна снова стоят друг против друга. Пулон больше не верит, что одинаковые щиты остановят бой. Ворен проверяет путь для раненых. Друзьям приходится действовать рядом или из разных лагерей — согласно выбранной стороне.",
        "en": ""
      },
      "next": "ch06_s01_n80"
    },
    {
      "id": "ch06_s01_n80",
      "scene": "ch06_s01",
      "kind": "beat",
      "beat": "beat_ch06_s01",
      "speaker": "narrator",
      "portrait": "",
      "text": {
        "ru": "",
        "en": ""
      },
      "next": "ch06_s01_n90"
    },
    {
      "id": "ch06_s01_n90",
      "scene": "ch06_s01",
      "kind": "dialogue",
      "speaker": "narrator",
      "portrait": "",
      "text": {
        "ru": "",
        "en": ""
      },
      "next": "ch06_s02_n01"
    },
    {
      "id": "ch06_s02_n01",
      "scene": "ch06_s02",
      "kind": "dialogue",
      "speaker": "history",
      "portrait": "brutus_worried",
      "text": {
        "ru": "Кассий и Брут терпят поражение в ходе двух сражений при Филиппах и погибают. Судьбу республики друзья не могут переписать. Зато они могут решить, кому достанется вода на пути от поля: своим по знамени или ближайшему по беде.",
        "en": ""
      },
      "next": "ch06_s02_n90"
    },
    {
      "id": "ch06_s02_n91",
      "scene": "ch06_s02",
      "kind": "dialogue",
      "speaker": "narrator",
      "portrait": "",
      "text": {
        "ru": "Пулон подаёт ковш через чужой щит. Несколько человек перестают быть только противниками.",
        "en": ""
      },
      "next": "ch06_s03_n01"
    },
    {
      "id": "ch06_s02_n92",
      "scene": "ch06_s02",
      "kind": "dialogue",
      "speaker": "narrator",
      "portrait": "",
      "text": {
        "ru": "Воды хватает на назначенную смену. Ворен запоминает лица тех, кому пришлось отказать.",
        "en": ""
      },
      "next": "ch06_s03_n01"
    },
    {
      "id": "ch06_s02_n90",
      "scene": "ch06_s02",
      "kind": "choice",
      "speaker": "narrator",
      "portrait": "",
      "text": {
        "ru": "",
        "en": ""
      },
      "choices": [
        {
          "id": "ch06_s02_water",
          "text": {
            "ru": "Раздать воду ближайшим раненым",
            "en": ""
          },
          "set_flags": [
            "water_shared"
          ],
          "clear_flags": [],
          "rep": {
            "citizens": 1
          },
          "bond": 4,
          "goto": "ch06_s02_n91",
          "condition": ""
        },
        {
          "id": "ch06_s02_unit",
          "text": {
            "ru": "Оставить запас своему отряду",
            "en": ""
          },
          "set_flags": [],
          "clear_flags": [],
          "rep": {
            "legion": 1
          },
          "bond": -2,
          "goto": "ch06_s02_n92",
